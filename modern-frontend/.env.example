# Google Maps Platform API key (Maps JavaScript API + Places + Geocoding).
# Create one at https://console.cloud.google.com/google-maps-apis and restrict
# it to http://localhost:5173/* (and your deployed origin). Without a key the
# hero location field keeps working but skips Places autocomplete and reverse
# geocoding (detection falls back to raw lat/lng).
VITE_GOOGLE_MAPS_API_KEY=

# Where the API lives. Defaults to "/api" - in development the Vite dev server
# proxies it to http://localhost:5000 (see vite.config.ts); in Docker the
# nginx container proxies it to the backend service.
# VITE_API_BASE_URL=http://localhost:5000/api
