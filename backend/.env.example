# Copy this file to backend/.env and fill in your Supabase project
# credentials (Supabase dashboard -> Project Settings -> API). Never commit
# the real .env file - it is gitignored.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-publishable-key

# SERVER-SIDE ONLY. Used solely to assign roles at registration (professional
# signup) and by the seed script. Never expose this key to the frontend -
# the browser app only ever uses the anon key above. Without it, customer
# registration still works but professional registration is refused.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImxrYXVkc3lndWZvY3VxenZpZGpjIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc4NjYwOTQyMiwiZXhwIjoyMTAyMTg1NDIyfQ.la_SsnSsqM-mvlGkLJbsijIXPgh6_5MQMARN58ykD5k

# Server
PORT=5000
NODE_ENV=development

# CORS - the origin(s) the frontend will be served from.
# Only matters if the frontend calls the API cross-origin; in dev the Vite
# proxy and in Docker the nginx proxy make it same-origin.
CLIENT_URL=http://127.0.0.1:5173
